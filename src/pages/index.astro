---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import BrandStrip from '../components/BrandStrip.astro';
import ServiceStrip from '../components/ServiceStrip.astro';
import SectionHead from '../components/SectionHead.astro';
import PackageExplorer from '../components/PackageExplorer.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import Reviews from '../components/Reviews.astro';
import PriceTag from '../components/PriceTag.astro';
import ArticleCards from '../components/ArticleCards.astro';
import QuoteForm from '../components/QuoteForm.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';
import { reviews } from '../data/reviews';
import { faqs } from '../data/faqs';
import type { PhotoKey } from '../data/photos';
import { packages, formatPrice, lowestPackagePrice, lowestReplacementPrice, priceNote } from '../data/prices';

const starter = packages[0];

const why = [
  {
    title: 'Family owned & run',
    text: `We’re a family business that has been heating and cooling South Australian homes for ${site.years}. When you call, you speak with us directly.`,
  },
  {
    title: 'Bulk-buy prices',
    text: 'We buy our systems in bulk, store them in our own two warehouses and keep overheads low, then pass those savings straight on to you.',
  },
  {
    title: 'Designed around your home',
    text: 'We calculate your home’s heat load and design the zones around how you live, so you never pay for a bigger system than you need.',
  },
  {
    title: 'Installed to the highest standard',
    text: 'Qualified, licensed and insured tradesmen, quality materials and real attention to detail. Our aim is 100% customer satisfaction.',
  },
];

const services: { photo: PhotoKey; icon: string; title: string; text: string; price: string; href: string }[] = [
  {
    photo: 'ceilingDiffuser',
    icon: 'house',
    title: 'Ducted reverse cycle',
    text: 'Whole-home heating and cooling from one hidden system, with zones for the rooms you actually use.',
    price: `From ${formatPrice(lowestPackagePrice)}*`,
    href: '/ducted-reverse-cycle-air-conditioners',
  },
  {
    photo: 'outdoorUnitsPair',
    icon: 'recycle',
    title: 'Replacement units',
    text: 'Swap an old, costly ducted unit for a new Samsung high-efficiency inverter on your existing ducting.',
    price: `From ${formatPrice(lowestReplacementPrice)}*`,
    href: '/air-conditioning-adelaide/ducted-air-conditioning-replacement-units',
  },
  {
    photo: 'livingRoomSplit',
    icon: 'wind',
    title: 'Split systems',
    text: 'Efficient heating and cooling for a single room. Quick to install, quiet and easy to maintain.',
    price: 'Free quote',
    href: '/home-air-conditioning-adelaide#split-systems',
  },
  {
    photo: 'thermostatWoman',
    icon: 'flame',
    title: 'Home heating',
    text: 'Reverse cycle is the most efficient way to heat your home. We’ll help you choose the right system.',
    price: 'Free advice',
    href: '/heating-your-home',
  },
];

const steps = [
  { icon: 'phone', title: 'Call or ask for a quote', text: `Speak with us directly on ${site.phone.display}, or send your details online.` },
  { icon: 'ruler', title: 'Free site inspection', text: 'We work out your heating and cooling needs and design the zones around how you live.' },
  { icon: 'file-text', title: 'A clear, installed price', text: 'You know exactly what you’ll pay. No deposit, and no extra or hidden costs.' },
  { icon: 'wrench', title: 'Installation day', text: 'Tradesmen arrive at 8am, put dust sheets down, then install, commission and test.' },
  { icon: 'sparkles', title: 'Handover & clean-up', text: 'We show you how to use your controller and take every bit of rubbish away.' },
];

const replacementIncludes = [
  'Removal of your old indoor and outdoor units',
  'New Samsung high-efficiency inverter',
  'New refrigeration pipes, control wiring and wall controller',
  'Connected to your existing ducting',
];

const homeFaqs = faqs.filter((f) =>
  ['Do I need to pay a deposit?', 'Are the prices on your website the real prices?', 'Which brands do you install?', 'How do you work out what size system I need?', 'What happens on installation day?'].includes(f.q),
);
---

<Base
  title="Ducted Air Conditioning Adelaide | Factory Direct Home Air Conditioning"
  fullTitle
  description={`Family-owned Adelaide air conditioning company for ${site.years}. Samsung, Fujitsu and Hisense ducted reverse cycle systems fully installed from ${formatPrice(starter.prices.samsung)}. No deposit, no hidden costs. Call ${site.phone.display}.`}
>
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <div class="hero__panel">
        <div class="hero__copy">
          <span class="eyebrow">Family owned · Adelaide · 20+ years</span>
          <h1 class="hero__title">Ducted air conditioning at <span class="hl">factory&#8209;direct</span> prices.</h1>
          <p class="lede hero__lede">
            We buy in bulk, keep our overheads low and store stock in our own two warehouses, so you pay less for a quality
            system installed by experienced tradesmen.
          </p>
          <ul class="ticks hero__ticks">
            <li>
              <span class="tick"><Icon name="check" /></span>
              <span>Ducted systems <strong>fully installed from {formatPrice(starter.prices.samsung)}*</strong></span>
            </li>
            <li><span class="tick"><Icon name="check" /></span><span>No deposit and no hidden costs</span></li>
            <li><span class="tick"><Icon name="check" /></span><span>Free, no-obligation in-home design</span></li>
          </ul>
          <div class="btn-row hero__actions">
            <a class="btn btn--navy btn--arrow" href="/price-list">
              See our price list <span class="btn__circle"><Icon name="arrow-up-right" /></span>
            </a>
            <a class="btn btn--outline" href={site.phone.href}><Icon name="phone" /> {site.phone.display}</a>
          </div>
          <div class="hero__brands">
            <BrandStrip compact />
          </div>
        </div>

        <div class="hero__media">
          <Photo name="outdoorUnitSky" eager class="hero__photo" sizes="(min-width: 1080px) 55vw, 100vw" />
          <div class="hero__form">
            <p class="hero__form-title">Get a free quote</p>
            <p class="hero__form-sub">Tell us what you need and we’ll call you back.</p>
            <QuoteForm id="hero-quote" compact />
          </div>
        </div>
      </div>
      <ServiceStrip />
    </div>
  </section>

  <!-- About / why us -->
  <section class="section" aria-labelledby="about-title">
    <div class="container">
      <SectionHead
        eyebrow="About us"
        id="about-title"
        title="Adelaide’s factory&#8209;direct air conditioning specialists."
        row
      >
        <a class="btn btn--outline btn--arrow" href="/home-air-conditioning-adelaide">
          Our services <span class="btn__circle"><Icon name="arrow-up-right" /></span>
        </a>
      </SectionHead>
      <div class="about">
        <div class="about__media">
          <Photo name="technicianOutdoorUnit" class="about__photo" sizes="(min-width: 980px) 45vw, 100vw" />
          <div class="about__badge">
            <span class="price-fig num">20+</span>
            <span>years keeping South Australian homes comfortable</span>
          </div>
        </div>
        <div class="about__list">
          {
            why.map((w, i) => (
              <details class="why" name="why" open={i === 0}>
                <summary>
                  <span class="why__n num">0{i + 1}.</span>
                  <span class="why__title">{w.title}</span>
                  <span class="why__btn" aria-hidden="true">
                    <Icon name="arrow-down-right" />
                  </span>
                </summary>
                <p>{w.text}</p>
              </details>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="services-wrap" aria-labelledby="services-title">
    <div class="container">
      <div class="services on-dark">
        <SectionHead eyebrow="What we do" id="services-title" title="Heating and cooling for every home." row>
          <a class="btn btn--primary btn--arrow" href="/home-air-conditioning-adelaide">
            All services <span class="btn__circle"><Icon name="arrow-up-right" /></span>
          </a>
        </SectionHead>
        <ul class="services__grid">
          {
            services.map((s) => (
              <li>
                <a class="svc" href={s.href}>
                  <Photo name={s.photo} class="svc__photo" sizes="(min-width: 1040px) 25vw, (min-width: 700px) 50vw, 100vw" widths={[480, 720, 960]} />
                  <div class="svc__body">
                    <span class="svc__icon">
                      <Icon name={s.icon} size={22} />
                    </span>
                    <h3>{s.title}</h3>
                    <p>{s.text}</p>
                    <div class="svc__foot">
                      <span class="svc__price">{s.price}</span>
                      <span class="icon-btn">
                        <Icon name="arrow-up-right" />
                      </span>
                    </div>
                  </div>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Prices -->
  <section class="section" aria-labelledby="prices-title">
    <div class="container">
      <SectionHead
        eyebrow="Price list"
        id="prices-title"
        title="Real prices, <span class='hl'>published</span> up front."
        lede="No guesswork. These are our fully installed prices for new ducted systems. Your exact price is confirmed at a free site inspection."
        row
      >
        <a class="text-link" href="/price-list">Full price list <span class="icon-btn"><Icon name="arrow-up-right" /></span></a>
      </SectionHead>
      <PackageExplorer id="home-pkgs" />
      <p class="fine prices__note">*{priceNote}</p>
    </div>
  </section>

  <!-- Replacement -->
  <section class="section section--surface" aria-labelledby="replace-title">
    <div class="container split split--wide-right">
      <div class="replace__media">
        <Photo name="outdoorUnitBrick" class="replace__photo" sizes="(min-width: 980px) 50vw, 100vw" />
        <div class="replace__tag">
          <PriceTag kicker="Ducted changeover" price={formatPrice(lowestReplacementPrice)} meta="Samsung inverter · 5-year warranty" />
        </div>
      </div>
      <div>
        <span class="eyebrow">Replacement units</span>
        <h2 id="replace-title" class="replace__title">Old ducted unit costing you a fortune?</h2>
        <p class="lede replace__lede">
          Older systems work harder, cost more to run and break down more often. A new Samsung high-efficiency inverter could
          save you hundreds to thousands of dollars a year on running and repair costs.
        </p>
        <ul class="ticks replace__list">
          {
            replacementIncludes.map((item) => (
              <li>
                <span class="tick">
                  <Icon name="check" />
                </span>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
        <a class="btn btn--navy btn--arrow" href="/air-conditioning-adelaide/ducted-air-conditioning-replacement-units">
          Replacement prices <span class="btn__circle"><Icon name="arrow-up-right" /></span>
        </a>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section" aria-labelledby="process-title">
    <div class="container">
      <SectionHead
        eyebrow="How it works"
        id="process-title"
        title="From first call to a comfortable home."
        lede="One customer called us on a Monday, we inspected the same day, and by Thursday their new ducted system was in. Here’s how it works."
        center
      />
      <ProcessSteps steps={steps} />
    </div>
  </section>

  <!-- Reviews -->
  <section class="section section--flush-top" aria-labelledby="reviews-title">
    <div class="container">
      <SectionHead eyebrow="Client reviews" id="reviews-title" title="What our customers say." row>
        <a class="text-link" href={site.facebook} rel="noopener" target="_blank"
          >Find us on Facebook <span class="icon-btn"><Icon name="arrow-up-right" /></span><span class="visually-hidden"> (opens in a new tab)</span></a
        >
      </SectionHead>
      <Reviews items={reviews.slice(0, 3)} />
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--surface" aria-labelledby="faq-title">
    <div class="container split split--top faq-split">
      <div class="faq-intro">
        <span class="eyebrow">FAQs</span>
        <h2 id="faq-title">Questions? We’ve got answers.</h2>
        <p class="lede">Straight answers to the things Adelaide homeowners ask us most.</p>
        <div class="faq-call">
          <Photo name="technicianGauges" class="faq-call__photo" sizes="160px" widths={[320]} />
          <div>
            <p class="faq-call__k">Still have a question?</p>
            <a class="faq-call__phone price-fig num" href={site.phone.href}>{site.phone.display}</a>
            <a class="text-link" href="/faqs">All FAQs <span class="icon-btn"><Icon name="arrow-right" /></span></a>
          </div>
        </div>
      </div>
      <FaqList items={homeFaqs} />
    </div>
  </section>

  <!-- Advice -->
  <section class="section" aria-labelledby="advice-title">
    <div class="container">
      <SectionHead eyebrow="Advice" id="advice-title" title="Expert advice before you buy." row>
        <a class="text-link" href="/faqs">All advice <span class="icon-btn"><Icon name="arrow-up-right" /></span></a>
      </SectionHead>
      <ArticleCards />
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  /* Hero */
  .hero {
    padding-top: clamp(12px, 2vw, 20px);
  }
  .hero__panel {
    display: grid;
    gap: 40px;
    align-items: center;
    padding: clamp(24px, 4vw, 56px);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(900px 420px at 0% 0%, rgb(255 198 41 / 0.18), transparent 60%),
      linear-gradient(180deg, var(--blue-50), var(--surface));
  }
  @media (min-width: 1080px) {
    .hero__panel {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
      align-items: stretch;
      gap: 48px;
      padding: 44px clamp(20px, 2vw, 28px) 44px 56px;
    }
    .hero__copy {
      align-self: center;
    }
  }
  .hero__title {
    margin-top: 1.1rem;
    max-width: 12ch;
    font-size: clamp(2.7rem, 2rem + 3.1vw, 4.6rem);
  }
  .hero__lede {
    margin-top: 1.2rem;
  }
  .hero__ticks {
    margin-top: 1.5rem;
    color: var(--ink);
    font-weight: 500;
  }
  .hero__ticks strong {
    font-weight: 750;
  }
  .hero__actions {
    margin-top: 1.9rem;
  }
  .hero__brands {
    margin-top: 2.2rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
  }

  .hero__media {
    position: relative;
    display: grid;
  }
  .hero__media :global(.hero__photo) {
    min-height: 560px;
    height: 100%;
    border-radius: var(--radius-lg);
  }
  .hero__form {
    position: absolute;
    left: 24px;
    top: 50%;
    transform: translateY(-50%);
    width: min(380px, calc(100% - 48px));
    padding: 26px 24px 18px;
    background: var(--white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }
  .hero__form-title {
    font-family: var(--font-display);
    font-size: 1.9rem;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.05;
  }
  .hero__form-sub {
    margin: 4px 0 16px;
    font-size: 0.93rem;
    color: var(--muted);
  }
  @media (max-width: 1079px) {
    .hero__media :global(.hero__photo) {
      min-height: 0;
      aspect-ratio: 4 / 3;
    }
    .hero__form {
      position: relative;
      left: auto;
      top: auto;
      transform: none;
      width: auto;
      margin: -72px 16px 0;
    }
  }
  @media (max-width: 520px) {
    .hero__panel {
      padding: 22px 16px 16px;
    }
    .hero__actions .btn {
      width: 100%;
    }
    .hero__form {
      margin-inline: 0;
      padding: 22px 18px 16px;
    }
  }
  .hero :global(.sstrip) {
    margin-top: clamp(20px, 3vw, 32px);
  }

  /* About */
  .about {
    display: grid;
    gap: clamp(28px, 4vw, 56px);
    align-items: center;
  }
  @media (min-width: 980px) {
    .about {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
  .about__media {
    position: relative;
  }
  .about__media :global(.about__photo) {
    aspect-ratio: 5 / 4;
  }
  .about__badge {
    position: absolute;
    left: 20px;
    bottom: 20px;
    display: flex;
    align-items: center;
    gap: 14px;
    max-width: 300px;
    padding: 16px 20px;
    border-radius: var(--radius);
    background: var(--yellow-400);
    color: var(--navy-900);
    font-weight: 700;
    line-height: 1.3;
    box-shadow: var(--shadow);
  }
  .about__badge .price-fig {
    font-size: 3rem;
  }
  .why {
    border-bottom: 1px solid var(--line);
  }
  .why summary {
    display: grid;
    grid-template-columns: 48px 1fr auto;
    align-items: center;
    gap: 12px;
    padding: 22px 0;
    cursor: pointer;
    list-style: none;
  }
  .why summary::-webkit-details-marker {
    display: none;
  }
  .why__n {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--muted);
  }
  .why__title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1.4rem + 0.6vw, 2rem);
    font-weight: 600;
    color: var(--ink);
    line-height: 1.1;
  }
  .why__btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1.5px solid var(--line);
    color: var(--navy-900);
    transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
  }
  .why__btn :global(svg) {
    width: 18px;
    height: 18px;
  }
  .why[open] .why__btn {
    background: var(--navy-900);
    border-color: var(--navy-900);
    color: var(--yellow-400);
  }
  .why:not([open]) .why__btn {
    transform: rotate(-90deg);
  }
  .why p {
    padding: 0 60px 24px 60px;
    margin-top: -6px;
  }
  @media (max-width: 560px) {
    .why summary {
      grid-template-columns: 38px 1fr auto;
    }
    .why p {
      padding: 0 0 22px 50px;
    }
  }

  /* Services */
  .services {
    padding: clamp(32px, 5vw, 64px);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(800px 400px at 100% 0%, rgb(47 123 234 / 0.35), transparent 60%),
      var(--navy-900);
  }
  .services__grid {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 18px;
  }
  @media (min-width: 700px) {
    .services__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1040px) {
    .services__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .svc {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--white);
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    color: var(--text);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .svc:hover {
    transform: translateY(-4px);
    box-shadow: 0 24px 40px -24px rgb(0 0 0 / 0.6);
  }
  .svc :global(.svc__photo) {
    aspect-ratio: 4 / 3;
    border-radius: 0;
  }
  .svc :global(.svc__photo img) {
    transition: transform 0.5s ease;
  }
  .svc:hover :global(.svc__photo img) {
    transform: scale(1.05);
  }
  .svc__body {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
    padding: 34px 22px 22px;
  }
  .svc__icon {
    position: absolute;
    top: -26px;
    left: 22px;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 16px;
    background: var(--yellow-400);
    color: var(--navy-900);
    box-shadow: 0 0 0 5px var(--white);
  }
  .svc h3 {
    font-size: 1.65rem;
    color: var(--ink);
  }
  .svc p {
    flex: 1;
    font-size: 0.95rem;
  }
  .svc__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 8px;
    padding-top: 14px;
    border-top: 1px solid var(--line-soft);
  }
  .svc__price {
    font-weight: 750;
    color: var(--ink);
  }
  .svc:hover .icon-btn {
    background: var(--yellow-400);
    border-color: var(--yellow-400);
    transform: rotate(-45deg);
  }

  .prices__note {
    margin-top: 18px;
  }

  /* Replacement */
  .replace__media {
    position: relative;
    padding-bottom: 40px;
  }
  .replace__media :global(.replace__photo) {
    aspect-ratio: 4 / 3;
  }
  .replace__tag {
    position: absolute;
    right: 20px;
    bottom: 0;
  }
  .replace__title {
    margin-top: 1rem;
  }
  .replace__lede {
    margin-top: 1rem;
  }
  .replace__list {
    margin-block: 1.6rem 2rem;
    color: var(--ink);
  }

  /* FAQ */
  .faq-intro h2 {
    margin-top: 1rem;
  }
  .faq-intro .lede {
    margin-top: 1rem;
  }
  .faq-call {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-top: 2rem;
    padding: 16px;
    background: var(--white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    max-width: 440px;
  }
  .faq-call :global(.faq-call__photo) {
    width: 96px;
    height: 96px;
    flex: none;
    border-radius: var(--radius);
  }
  .faq-call__k {
    font-weight: 700;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .faq-call__phone {
    display: block;
    font-size: 2rem;
    text-decoration: none;
    margin: 2px 0 6px;
  }
  @media (min-width: 980px) {
    .faq-intro {
      position: sticky;
      top: calc(var(--header-h) + 32px);
    }
  }
</style>
