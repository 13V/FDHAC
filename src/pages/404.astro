---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

const links = [
  { label: 'Ducted air conditioning', href: '/ducted-reverse-cycle-air-conditioners' },
  { label: 'Replacement units', href: '/air-conditioning-adelaide/ducted-air-conditioning-replacement-units' },
  { label: 'Price list', href: '/price-list' },
  { label: 'Advice & FAQs', href: '/faqs' },
];
---

<Base title="Page not found" description="Sorry, we couldn’t find that page." noindex>
  <section class="nf">
    <div class="container">
      <div class="nf__panel">
        <p class="nf__code price-fig">404</p>
        <h1>This page has gone off the grid.</h1>
        <p class="lede">The page you’re after may have moved when we updated our website. Try one of these instead, or give us a call.</p>
        <div class="btn-row nf__actions">
          <a class="btn btn--primary btn--arrow" href="/">Back to home <span class="btn__circle"><Icon name="arrow-up-right" /></span></a>
          <a class="btn btn--outline" href={site.phone.href}><Icon name="phone" /> {site.phone.display}</a>
        </div>
        <ul class="nf__links">
          {links.map((l) => <li><a class="text-link" href={l.href}>{l.label} <span class="icon-btn"><Icon name="arrow-right" /></span></a></li>)}
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf {
    padding-block: clamp(12px, 2vw, 20px) var(--section);
  }
  .nf__panel {
    padding: clamp(32px, 6vw, 88px);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(900px 420px at 0% 0%, rgb(255 198 41 / 0.2), transparent 60%),
      linear-gradient(180deg, var(--blue-50), var(--surface));
    text-align: center;
  }
  .nf__code {
    font-size: clamp(5rem, 3rem + 8vw, 9rem);
    color: var(--yellow-400);
    -webkit-text-stroke: 2px var(--navy-900);
  }
  .nf h1 {
    margin-top: 0.5rem;
    font-size: clamp(2.2rem, 1.7rem + 2.4vw, 3.6rem);
  }
  .nf .lede {
    margin: 1rem auto 0;
  }
  .nf__actions {
    justify-content: center;
    margin-top: 2rem;
  }
  .nf__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px 28px;
    margin-top: 2.4rem;
    list-style: none;
    padding: 0;
  }
</style>
