---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import Icon from '../components/Icon.astro';
import HouseDiagram from '../components/HouseDiagram.astro';
import MediaSplit from '../components/MediaSplit.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import PackageExplorer from '../components/PackageExplorer.astro';
import PriceTag from '../components/PriceTag.astro';
import Reviews from '../components/Reviews.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';
import { reviews } from '../data/reviews';
import { formatPrice, lowestPackagePrice, priceNote } from '../data/prices';

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Air conditioning', href: '/home-air-conditioning-adelaide' },
  { label: 'Ducted reverse cycle', href: '/ducted-reverse-cycle-air-conditioners' },
];

const benefits = [
  { icon: 'calendar-check', title: 'Usable all year', text: 'One system cools your home in summer and heats it in winter.' },
  { icon: 'house', title: 'Comfort in every room', text: 'Air-conditioned comfort right through the whole house.' },
  { icon: 'sparkles', title: 'Minimal visual impact', text: 'The indoor unit sits out of sight in your roof space. All you see are neat ceiling outlets.' },
  { icon: 'gauge', title: 'Centralised control', text: 'Run the whole house, or just the zones you need, from one wall controller.' },
  { icon: 'flame', title: 'The most efficient heating', text: 'Reverse cycle is the most efficient way to heat your home.' },
  { icon: 'badge-check', title: 'Adds value to your home', text: 'It’s the most desirable form of air conditioning, so it adds value to your home.' },
  { icon: 'wind', title: 'Minimal noise', text: 'Quiet indoors, with the outdoor unit placed where you choose.' },
  { icon: 'layers', title: 'Zoned to save energy', text: 'Motorised zones shut off the areas you aren’t using.' },
];
---

<Base
  title="Ducted Reverse Cycle Air Conditioning Adelaide"
  description={`Ducted reverse cycle air conditioning in Adelaide, designed for your home with zoning. Samsung, Fujitsu and Hisense systems from 7.1 kW to 36 kW, fully installed from ${formatPrice(lowestPackagePrice)}. Free, no-obligation design.`}
  breadcrumbs={crumbs}
>
  <PageHero
    crumbs={crumbs}
    eyebrow="Ducted reverse cycle"
    title="Every room comfortable, <span class='hl'>all year</span>, from one system."
    lede="Ducted reverse cycle air conditioning heats and cools your whole home from a single, out-of-sight unit. Motorised zones shut off the areas you aren’t using, cutting your energy use."
    photo="ceilingDiffuser"
  >
    <Fragment slot="actions">
      <a class="btn btn--primary btn--arrow" href="/contact">Free design &amp; quote <span class="btn__circle"><Icon name="arrow-up-right" /></span></a>
      <a class="btn btn--outline" href="/price-list">See prices</a>
    </Fragment>
    <ul class="facts" slot="aside">
      <li><span class="facts__k">Systems from</span><span class="facts__v">7.1 kW single phase</span></li>
      <li><span class="facts__k">Up to</span><span class="facts__v">36 kW three phase</span></li>
    </ul>
  </PageHero>

  <!-- How it works -->
  <section class="section" aria-labelledby="how-title">
    <div class="container">
      <SectionHead
        eyebrow="How it works"
        id="how-title"
        title="How ducted reverse cycle works."
        lede="Switch between cooling and heating, and turn the zones on and off, to see what the system is doing."
      />
      <div class="how">
        <HouseDiagram id="ducted-house" annotated zones />
        <div class="how__text">
          <h3>Air in, air out</h3>
          <p>
            Air is drawn up through a return grille, usually in a central spot like the hallway. It’s heated or cooled, then
            supplied back through outlets towards the outside of each room. The supply air is usually about 10 degrees cooler
            or warmer than the air drawn in.
          </p>
          <h3>Zones do the saving</h3>
          <p>
            Motorised zones switch off the parts of the house you aren’t using. Because you’re rarely heating or cooling every
            room at once, a zoned home can often use a smaller unit than you’d need for the whole house.
          </p>
          <div class="callout callout--blue">
            <Icon name="info" />
            <p>
              Living areas (lounge, kitchen and family room) generally make up about two-thirds of a typical home’s heat load.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Sizing -->
  <section class="section section--surface" aria-labelledby="size-title">
    <div class="container">
      <MediaSplit photo="technicianIndoor" eyebrow="Designed for you" id="size-title" title="Sized properly. Never oversized." ratio="4 / 5" photoPosition="50% 30%">
        <p class="lede">
          A ducted system has to be designed around your home. Our consultants perform a heat load calculation to work out
          exactly what you need, so you get a system that meets all your requirements without overspending.
        </p>
        <ul class="ticks">
          <li><span class="tick"><Icon name="check" /></span><span>Free, no-obligation design and quote</span></li>
          <li><span class="tick"><Icon name="check" /></span><span>Zones planned around how you use your home</span></li>
          <li><span class="tick"><Icon name="check" /></span><span>Capacity quoted in kW, never “horsepower”</span></li>
          <li><span class="tick"><Icon name="check" /></span><span>Qualified, licensed, insured and experienced installers</span></li>
        </ul>
        <div class="btn-row">
          <a class="btn btn--navy btn--arrow" href="/contact">Book a free design <span class="btn__circle"><Icon name="arrow-up-right" /></span></a>
          <a class="btn btn--outline" href={site.phone.href}><Icon name="phone" /> {site.phone.display}</a>
        </div>
        <Fragment slot="overlay">
          <div class="size__tag">
            <PriceTag kicker="Ducted systems" price={formatPrice(lowestPackagePrice)} meta="Samsung 7 kW · 4 outlets · 2 zones" />
          </div>
        </Fragment>
      </MediaSplit>
    </div>
  </section>

  <!-- Benefits -->
  <section class="section" aria-labelledby="benefits-title">
    <div class="container">
      <SectionHead eyebrow="Key benefits" id="benefits-title" title="The ultimate in home comfort." center />
      <FeatureGrid items={benefits} cols={4} />
      <p class="fine benefits__note">Subject to site inspection.</p>
    </div>
  </section>

  <!-- Brands -->
  <section class="section section--flush-top" aria-labelledby="brand-title">
    <div class="container">
      <div class="brandbox">
        <div>
          <span class="eyebrow">Brands</span>
          <h2 id="brand-title">Why we recommend Samsung.</h2>
          <p class="lede">
            We’re proud to supply Samsung ducted reverse cycle air conditioners. As well as being a trustworthy brand, Samsung
            systems are efficient, reliable and affordable, and come with an exceptional warranty. We also supply and install
            Fujitsu and Hisense.
          </p>
        </div>
        <ul class="brandbox__list">
          <li><Icon name="zap" /> Efficient</li>
          <li><Icon name="shield-check" /> Reliable</li>
          <li><Icon name="banknote" /> Affordable</li>
          <li><Icon name="badge-check" /> Great warranty</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Packages -->
  <section class="section section--surface" aria-labelledby="pkg-title">
    <div class="container">
      <SectionHead eyebrow="Packages" id="pkg-title" title="Ducted packages, fully installed." row>
        <a class="text-link" href="/price-list">Full price list <span class="icon-btn"><Icon name="arrow-up-right" /></span></a>
      </SectionHead>
      <PackageExplorer id="ducted-pkgs" />
      <p class="fine pkg__note">*{priceNote}</p>
    </div>
  </section>

  <!-- Reviews -->
  <section class="section" aria-labelledby="reviews-title">
    <div class="container">
      <SectionHead eyebrow="Client reviews" id="reviews-title" title="Ducted installs our customers love." />
      <Reviews items={reviews.slice(0, 2)} />
    </div>
  </section>

  <CtaBand
    title="Get a ducted system designed for your home."
    text="Our consultants will design the right system for your needs and budget. There’s no obligation, and it’s free."
  />
</Base>

<style>
  .facts {
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 18px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    list-style: none;
    padding: 0;
  }
  .facts li {
    display: grid;
    padding: 14px 16px;
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.94);
    box-shadow: var(--shadow-sm);
    line-height: 1.25;
  }
  .facts__k {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--blue-600);
  }
  .facts__v {
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--ink);
  }

  .how {
    display: grid;
    gap: clamp(28px, 4vw, 56px);
    align-items: start;
  }
  @media (min-width: 1100px) {
    .how {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    }
  }
  .how__text h3 {
    font-size: 1.8rem;
  }
  .how__text h3 + p {
    margin-top: 0.6rem;
  }
  .how__text p + h3 {
    margin-top: 2rem;
  }
  .how__text .callout {
    margin-top: 1.6rem;
  }

  .size__tag {
    position: absolute;
    right: -12px;
    bottom: 24px;
  }
  @media (max-width: 979px) {
    .size__tag {
      right: 12px;
    }
  }

  .benefits__note,
  .pkg__note {
    margin-top: 18px;
  }

  .brandbox {
    display: grid;
    gap: 28px;
    align-items: center;
    padding: clamp(28px, 4vw, 56px);
    border-radius: var(--radius-xl);
    background: var(--yellow-100);
  }
  @media (min-width: 980px) {
    .brandbox {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      gap: 56px;
    }
  }
  .brandbox h2 {
    margin-top: 1rem;
  }
  .brandbox .lede {
    margin-top: 1rem;
    color: var(--text);
  }
  .brandbox .eyebrow {
    background: var(--white);
    border-color: transparent;
  }
  .brandbox__list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    list-style: none;
    padding: 0;
  }
  .brandbox__list li {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 16px 18px;
    border-radius: var(--radius);
    background: var(--white);
    font-weight: 700;
    color: var(--ink);
  }
  .brandbox__list :global(svg) {
    color: var(--blue-600);
    flex: none;
  }
</style>
