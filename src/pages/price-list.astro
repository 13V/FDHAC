---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import Icon from '../components/Icon.astro';
import PriceTable from '../components/PriceTable.astro';
import ReplacementGrid from '../components/ReplacementGrid.astro';
import BrandStrip from '../components/BrandStrip.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';
import { faqs } from '../data/faqs';
import { packages, brandLabels, formatPrice, lowestPackagePrice, lowestReplacementPrice, priceNote, type Brand } from '../data/prices';

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Price list', href: '/price-list' },
];

const brands = Object.keys(brandLabels) as Brand[];
const offerSchema = {
  '@context': 'https://schema.org',
  '@type': 'OfferCatalog',
  name: 'Ducted reverse cycle air conditioning packages',
  itemListElement: packages.flatMap((p) =>
    brands.map((b) => ({
      '@type': 'Offer',
      name: `${brandLabels[b]} ${p.kw} kW ducted inverter, ${p.outlets} outlets and ${p.zones} zones, fully installed`,
      price: p.prices[b],
      priceCurrency: 'AUD',
      seller: { '@id': `${site.url}/#business` },
    })),
  ),
};

const steps = [
  { icon: 'phone', title: 'Call or send a request', text: 'Tell us about your home and what you’re after.' },
  { icon: 'ruler', title: 'Free site inspection', text: 'We check your home, design the zones and confirm your price.' },
  { icon: 'wrench', title: 'Installed, no deposit', text: 'We install on a date that suits you. No extra or hidden costs.' },
];

const priceFaqs = faqs.filter((f) =>
  ['Are the prices on your website the real prices?', 'Do I need to pay a deposit?', 'How do you work out what size system I need?', 'Why do you quote in kW and not horsepower?'].includes(f.q),
);
---

<Base
  title="Ducted Air Conditioning Price List Adelaide"
  description={`Our published price list: ducted reverse cycle systems fully installed from ${formatPrice(lowestPackagePrice)}, and ducted replacement units from ${formatPrice(lowestReplacementPrice)}. Samsung and Fujitsu. Adelaide.`}
  breadcrumbs={crumbs}
  schema={offerSchema}
>
  <PageHero
    crumbs={crumbs}
    eyebrow="Price list"
    title="Fully installed prices. <span class='hl'>No surprises.</span>"
    lede="Samsung, Fujitsu and Hisense are leading air conditioning brands, renowned for great prices and outstanding reliability. That’s why we’re proud to recommend them. For the best price and service, call us today."
  >
    <Fragment slot="actions">
      <a class="btn btn--primary btn--arrow" href="/contact">Book a free site inspection <span class="btn__circle"><Icon name="arrow-up-right" /></span></a>
      <a class="btn btn--outline" href={site.phone.href}><Icon name="phone" /> {site.phone.display}</a>
    </Fragment>
    <ul class="pfacts" slot="aside">
      <li><span class="icon-chip"><Icon name="banknote" /></span><span><strong>No deposit</strong>Pay once the job is done</span></li>
      <li><span class="icon-chip"><Icon name="badge-check" /></span><span><strong>No hidden costs</strong>Fully installed prices</span></li>
      <li><span class="icon-chip"><Icon name="ruler" /></span><span><strong>Free site inspection</strong>Your price confirmed on site</span></li>
    </ul>
  </PageHero>

  <section class="section" aria-labelledby="new-title">
    <div class="container">
      <SectionHead
        eyebrow="New ducted systems"
        id="new-title"
        title="Ducted inverter packages."
        lede="Each package is ducted to the outlets and zones shown. Every home is different, so your exact price is confirmed at a free site inspection."
      />
      <PriceTable />
      <p class="fine pl__note">*{priceNote}</p>
      <div class="pl__brands">
        <BrandStrip />
      </div>
    </div>
  </section>

  <section class="section section--surface" aria-labelledby="rep-title">
    <div class="container">
      <SectionHead
        eyebrow="Replacing an old system?"
        id="rep-title"
        title="Ducted replacement units."
        lede="Swap your old ducted unit for a new Samsung high-efficiency inverter, connected to your existing ducting. Removal of your old system is included."
        row
      >
        <a class="text-link" href="/air-conditioning-adelaide/ducted-air-conditioning-replacement-units"
          >What’s included <span class="icon-btn"><Icon name="arrow-up-right" /></span></a
        >
      </SectionHead>
      <ReplacementGrid />
      <p class="fine pl__note">*{priceNote} Replacing zones or flexible ducting isn’t included.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="how-title">
    <div class="container">
      <SectionHead eyebrow="How it works" id="how-title" title="Three steps to your installed price." center />
      <ol class="psteps">
        {
          steps.map((s, i) => (
            <li>
              <span class="psteps__n price-fig num">{i + 1}</span>
              <span class="icon-chip icon-chip--navy">
                <Icon name={s.icon} />
              </span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--surface" aria-labelledby="pfaq-title">
    <div class="container container--narrow">
      <SectionHead eyebrow="FAQs" id="pfaq-title" title="Pricing questions." center />
      <FaqList items={priceFaqs} />
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .pfacts {
    display: grid;
    gap: 12px;
    list-style: none;
    padding: 0;
  }
  .pfacts li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 16px;
    align-items: center;
    padding: 16px;
    border-radius: var(--radius-lg);
    background: var(--white);
    box-shadow: var(--shadow-sm);
  }
  .pfacts li > span:last-child {
    display: grid;
    font-size: 0.93rem;
    color: var(--muted);
    line-height: 1.35;
  }
  .pfacts strong {
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 600;
    color: var(--ink);
  }
  .pl__note {
    margin-top: 18px;
  }
  .pl__brands {
    margin-top: clamp(32px, 4vw, 48px);
    padding: 24px 28px;
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  .psteps {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 18px;
  }
  @media (min-width: 900px) {
    .psteps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .psteps li {
    position: relative;
    padding: 28px;
    border-radius: var(--radius-lg);
    background: var(--white);
    border: 1px solid var(--line-soft);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }
  .psteps__n {
    position: absolute;
    right: 18px;
    top: 4px;
    font-size: 6rem;
    color: var(--surface-2);
  }
  .psteps h3 {
    margin-top: 18px;
  }
  .psteps p {
    margin-top: 6px;
  }
</style>
