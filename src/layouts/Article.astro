---
import Base from './Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import ArticleCards from '../components/ArticleCards.astro';
import SectionHead from '../components/SectionHead.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import type { PhotoKey } from '../data/photos';

interface Props {
  title: string;
  description: string;
  crumb: string;
  heading: string;
  lede: string;
  photo: PhotoKey;
  toc: { id: string; label: string }[];
}

const { title, description, crumb, heading, lede, photo, toc } = Astro.props;
const path = Astro.url.pathname.replace(/\.html$/, '');
const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Advice', href: '/faqs' },
  { label: crumb, href: path },
];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: heading,
  description,
  author: { '@id': `${site.url}/#business` },
  publisher: { '@id': `${site.url}/#business` },
  mainEntityOfPage: new URL(path, site.url).href,
};
---

<Base title={title} description={description} breadcrumbs={crumbs} schema={articleSchema}>
  <PageHero crumbs={crumbs} eyebrow="Advice" title={heading} lede={lede} photo={photo} />

  <div class="container article">
    <article class="prose article__body">
      <slot />
    </article>

    <aside class="article__aside">
      <nav class="toc" aria-label="On this page">
        <p class="label">On this page</p>
        <ol>
          {
            toc.map((t) => (
              <li>
                <a href={`#${t.id}`}>{t.label}</a>
              </li>
            ))
          }
        </ol>
      </nav>
      <div class="aside-cta on-dark">
        <span class="aside-cta__icon"><Icon name="phone" /></span>
        <p class="aside-cta__title">Talk to a local expert</p>
        <p class="aside-cta__text">Free, no-obligation advice from a family business that’s been doing this for {site.years}.</p>
        <a class="aside-cta__phone price-fig num" href={site.phone.href}>{site.phone.display}</a>
        <a class="btn btn--primary btn--arrow btn--block" href="/contact">
          Get a free quote <span class="btn__circle"><Icon name="arrow-up-right" /></span>
        </a>
      </div>
    </aside>
  </div>

  <section class="section section--surface">
    <div class="container">
      <SectionHead eyebrow="More advice" title="Keep reading." />
      <ArticleCards exclude={path} />
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .article {
    display: grid;
    gap: 48px;
    padding-block: clamp(48px, 6vw, 88px) var(--section);
  }
  @media (min-width: 1024px) {
    .article {
      grid-template-columns: minmax(0, 1fr) 320px;
      gap: 72px;
    }
    .article__aside {
      position: sticky;
      top: calc(var(--header-h) + 28px);
      align-self: start;
    }
  }
  .article__body > :global(:first-child) {
    margin-top: 0;
  }
  .toc {
    padding: 22px 24px;
    margin-bottom: 18px;
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  .toc .label {
    color: var(--blue-600);
    margin-bottom: 10px;
  }
  .toc ol {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 2px;
    counter-reset: toc;
  }
  .toc li {
    counter-increment: toc;
  }
  .toc a {
    display: grid;
    grid-template-columns: 30px 1fr;
    padding: 7px 0;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--ink);
    text-decoration: none;
    line-height: 1.35;
  }
  .toc a::before {
    content: counter(toc, decimal-leading-zero);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--muted);
  }
  .toc a:hover {
    color: var(--blue-600);
  }
  .aside-cta {
    display: grid;
    gap: 10px;
    padding: 26px 24px;
    border-radius: var(--radius-lg);
    background:
      radial-gradient(400px 200px at 100% 0%, rgb(47 123 234 / 0.4), transparent 70%),
      var(--navy-900);
  }
  .aside-cta__icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: var(--yellow-400);
    color: var(--navy-900);
  }
  .aside-cta__title {
    margin-top: 6px;
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--white);
    line-height: 1.05;
  }
  .aside-cta__text {
    font-size: 0.93rem;
  }
  .aside-cta__phone {
    font-size: 2.1rem;
    color: var(--white);
    text-decoration: none;
    margin-block: 4px 8px;
  }
  @media (max-width: 1023px) {
    .toc {
      display: none;
    }
  }
</style>
