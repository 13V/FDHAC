---
/** Full price list: every package with Samsung and Fujitsu side by side. */
import { packages, brandLabels, formatPrice, type Brand } from '../data/prices';

const brands = Object.keys(brandLabels) as Brand[];
---

<div class="ptable">
  <table class="data-table">
    <caption class="visually-hidden">New ducted inverter systems, fully installed prices</caption>
    <thead>
      <tr>
        <th scope="col">Package</th>
        <th scope="col">System</th>
        <th scope="col">Outlets &amp; zones</th>
        <th scope="col">Suits</th>
        {brands.map((b) => <th scope="col" class="ptable__brand">{brandLabels[b]} from</th>)}
      </tr>
    </thead>
    <tbody>
      {
        packages.map((p) => (
          <tr>
            <th scope="row" class="ptable__pkg">
              <span class="ptable__badge num">{p.id}</span>
              <span class="ptable__pkg-label">Package {p.id}</span>
            </th>
            <td data-label="System" class="ptable__sys">
              <strong class="price-fig num">{p.kw} kW</strong> ducted inverter
            </td>
            <td data-label="Outlets & zones" class="num">
              {p.outlets} outlets · {p.zones} zones
            </td>
            <td data-label="Suits" class="ptable__suits">{p.suits}</td>
            {brands.map((b) => (
              <td data-label={`${brandLabels[b]} from`} class="ptable__price">
                <span class="price-fig num">{formatPrice(p.prices[b])}</span>
                <sup>*</sup>
              </td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .ptable {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }
  .ptable__brand,
  .ptable__price {
    text-align: right !important;
  }
  .ptable__pkg {
    white-space: nowrap;
  }
  .ptable__badge {
    display: inline-grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--yellow-400);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--navy-900);
  }
  .ptable__pkg-label {
    display: none;
  }
  .ptable__sys strong {
    font-size: 1.5rem;
    margin-right: 4px;
  }
  .ptable__suits {
    color: var(--muted);
    max-width: 26ch;
  }
  .ptable__price .price-fig {
    font-size: 1.75rem;
  }
  .ptable sup {
    color: var(--yellow-500);
    font-weight: 700;
  }
  tbody tr:last-child > * {
    border-bottom: 0;
  }
  tbody tr {
    transition: background-color 0.15s ease;
  }
  tbody tr:hover {
    background: var(--blue-50);
  }

  @media (max-width: 860px) {
    .data-table thead {
      display: none;
    }
    .data-table,
    .data-table tbody,
    .data-table tr,
    .data-table th,
    .data-table td {
      display: block;
      width: 100%;
    }
    .data-table tr {
      padding: 18px 20px;
      border-bottom: 1px solid var(--line);
    }
    .data-table tbody tr:last-child {
      border-bottom: 0;
    }
    .data-table th,
    .data-table td {
      padding: 5px 0;
      border: 0;
    }
    .data-table td[data-label] {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 16px;
      text-align: right;
    }
    .data-table td[data-label]::before {
      content: attr(data-label);
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: var(--muted);
      text-align: left;
    }
    .ptable__pkg {
      display: flex !important;
      align-items: center;
      gap: 10px;
      margin-bottom: 6px;
    }
    .ptable__pkg-label {
      display: inline;
      font-family: var(--font-display);
      font-size: 1.4rem;
      font-weight: 600;
      color: var(--ink);
    }
    .ptable__suits {
      max-width: none;
    }
  }
</style>
