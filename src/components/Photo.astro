---
/** Responsive, optimised photo (AVIF/WebP) in a rounded frame. */
import { Picture } from 'astro:assets';
import { photos, type PhotoKey } from '../data/photos';

interface Props {
  name: PhotoKey;
  sizes?: string;
  widths?: number[];
  eager?: boolean;
  class?: string;
  alt?: string;
  position?: string;
  rounded?: boolean;
}

const {
  name,
  sizes = '(min-width: 1040px) 50vw, 100vw',
  widths = [480, 720, 960, 1280, 1680],
  eager = false,
  class: className,
  alt,
  position,
  rounded = true,
} = Astro.props;
const p = photos[name];
const objectPosition = position ?? ('position' in p ? p.position : undefined) ?? '50% 50%';
---

<div class:list={[{ photo: rounded }, 'photo-frame', className]}>
  <Picture
    src={p.src}
    alt={alt ?? p.alt}
    widths={widths.filter((w) => w <= p.src.width)}
    sizes={sizes}
    formats={['avif', 'webp']}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    decoding={eager ? 'sync' : 'async'}
    style={`object-position: ${objectPosition}`}
  />
</div>

<style>
  .photo-frame {
    position: relative;
    overflow: hidden;
  }
  .photo-frame :global(picture),
  .photo-frame :global(img) {
    width: 100%;
    height: 100%;
  }
  .photo-frame :global(img) {
    object-fit: cover;
  }
</style>
