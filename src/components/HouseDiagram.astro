    grid-template-columns: 26px 1fr;
    gap: 10px;
    align-items: start;
    line-height: 1.45;
  }
  .house__legend-n {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--yellow-400);
    color: var(--navy-900);
    font-weight: 800;
    font-size: 0.8rem;
    line-height: 1;
  }
</style>

<script>
  const loads = { z1: 67, z2: 33 } as const;

  document.querySelectorAll<HTMLElement>('[data-house]').forEach((house) => {
    const modeBtns = house.querySelectorAll<HTMLButtonElement>('[data-mode-btn]');
    const zoneBtns = house.querySelectorAll<HTMLButtonElement>('[data-zone]');
    const status = house.querySelector<HTMLElement>('[data-house-status]');
    const loadValue = house.querySelector<HTMLElement>('[data-load-value]');
    const loadBar = house.querySelector<HTMLElement>('[data-load-bar]');

    const describe = () => {
      const heat = house.dataset.mode === 'heat';
      const on = (['z1', 'z2'] as const).filter((z) => house.dataset[z] !== 'off');
      const load = on.reduce((sum, z) => sum + loads[z], 0);
      if (loadValue) loadValue.textContent = load ? `${load}%` : 'System off';
      if (loadBar) loadBar.style.width = `${load}%`;
      if (status) {
        const temps = heat ? 'Heating: 7°C outside, 21°C inside.' : 'Cooling: 38°C outside, 24°C inside.';
        const zoneText = zoneBtns.length ? ` Heat load ${load}%.` : '';
        status.textContent = temps + zoneText;
      }
    };

    modeBtns.forEach((btn) =>
      btn.addEventListener('click', () => {
        house.dataset.mode = btn.dataset.modeBtn;
        modeBtns.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        describe();
      }),
    );

    zoneBtns.forEach((btn) =>
      btn.addEventListener('click', () => {
        const zone = btn.dataset.zone as 'z1' | 'z2';
        const on = btn.getAttribute('aria-pressed') !== 'true';
        btn.setAttribute('aria-pressed', String(on));
        house.dataset[zone] = on ? 'on' : 'off';
        describe();
      }),
    );
  });
</script>
