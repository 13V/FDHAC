---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site, mainNav } from '../data/site';

const advicePaths = [
  '/faqs',
  '/how-to-reduce-air-conditioning-running-costs',
  '/what-is-horsepower',
  '/air-conditioning-maintenance-tips',
];

const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/faqs' ? advicePaths.includes(path) : path === href);
---

<section class="topbar" aria-label="Business details">
  <div class="container topbar__inner">
    <p class="topbar__msg">
      <Icon name="house" size={15} />
      Family owned &amp; run in South Australia for {site.years}
    </p>
    <ul class="topbar__links">
      <li><a href={`mailto:${site.email}`}><Icon name="mail" size={15} /> {site.email}</a></li>
      <li>
        <a href={site.facebook} rel="noopener" target="_blank"
          ><Icon name="facebook" size={15} /> Facebook<span class="visually-hidden"> (opens in a new tab)</span></a
        >
      </li>
    </ul>
  </div>
</section>

<header class="header" data-header>
  <div class="container header__inner">
    <a href="/" class="header__brand" aria-label={`${site.name}, home`}>
      <Logo title={site.name} />
    </a>

    <nav class="header__nav" aria-label="Main">
      <ul>
        {
          mainNav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header__actions">
      <a class="header__phone" href={site.phone.href}>
        <span class="header__phone-icon"><Icon name="phone" size={18} /></span>
        <span class="header__phone-text">
          <span>Call us direct</span>
          <strong class="num">{site.phone.display}</strong>
        </span>
      </a>
      <a class="btn btn--primary btn--sm btn--arrow header__quote" href="/contact">
        Free quote <span class="btn__circle"><Icon name="arrow-up-right" /></span>
      </a>
      <a class="header__call-mobile" href={site.phone.href} aria-label={`Call ${site.phone.display}`}>
        <Icon name="phone" size={20} />
      </a>
      <button class="header__menu" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
        <span class="header__menu-open"><Icon name="menu" size={24} /></span>
        <span class="header__menu-close"><Icon name="x" size={24} /></span>
        <span class="visually-hidden">Menu</span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-menu hidden>
    <nav class="container" aria-label="Mobile">
      <ul class="mobile-menu__list">
        <li><a href="/" aria-current={path === '/' ? 'page' : undefined}>Home <Icon name="arrow-right" size={20} /></a></li>
        {
          mainNav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label} <Icon name="arrow-right" size={20} />
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mobile-menu__actions">
        <a class="btn btn--primary btn--block" href="/contact">Get a free quote</a>
        <a class="btn btn--outline btn--block" href={site.phone.href}><Icon name="phone" /> Call {site.phone.display}</a>
        <a class="mobile-menu__email" href={`mailto:${site.email}`}><Icon name="mail" size={18} /> {site.email}</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .topbar {
    background: var(--navy-900);
    color: rgb(255 255 255 / 0.8);
    font-size: 0.84rem;
  }
  .topbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 42px;
  }
  .topbar__msg {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .topbar__msg :global(svg) {
    color: var(--yellow-400);
  }
  .topbar__links {
    display: flex;
    gap: 22px;
    list-style: none;
    padding: 0;
  }
  .topbar__links a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    text-decoration: none;
  }
  .topbar__links a:hover {
    color: var(--white);
  }
  @media (max-width: 860px) {
    .topbar {
      display: none;
    }
  }

  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(255 255 255 / 0.96);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .header.is-scrolled {
    border-bottom-color: var(--line-soft);
    box-shadow: 0 10px 30px -20px rgb(11 29 58 / 0.35);
  }
  .header__inner {
    display: flex;
    align-items: center;
    gap: 28px;
    min-height: var(--header-h);
  }
  .header__brand {
    flex: none;
    color: var(--navy-900);
    display: block;
  }
  .header__brand :global(svg) {
    width: 104px;
    height: 54px;
    max-width: none;
  }

  .header__nav {
    margin-inline: auto;
  }
  .header__nav ul {
    display: flex;
    gap: 6px;
    list-style: none;
    padding: 0;
  }
  .header__nav a {
    position: relative;
    display: block;
    padding: 10px 14px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.97rem;
    color: var(--ink);
    text-decoration: none;
    transition: background-color 0.18s ease;
  }
  .header__nav a:hover {
    background: var(--surface);
  }
  .header__nav a[aria-current='page'] {
    background: var(--yellow-100);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .header__phone {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--ink);
  }
  .header__phone-icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--blue-50);
    color: var(--blue-600);
    transition: background-color 0.18s ease, color 0.18s ease;
  }
  .header__phone:hover .header__phone-icon {
    background: var(--navy-900);
    color: var(--yellow-400);
  }
  .header__phone-text {
    display: grid;
    line-height: 1.2;
  }
  .header__phone-text span {
    font-size: 0.76rem;
    color: var(--muted);
    font-weight: 600;
  }
  .header__phone-text strong {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  .header__call-mobile,
  .header__menu {
    display: none;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1.5px solid var(--line);
    background: var(--white);
    color: var(--navy-900);
  }
  .header__call-mobile {
    background: var(--yellow-400);
    border-color: var(--yellow-400);
  }
  .header__menu span {
    line-height: 0;
  }
  .header__menu-close {
    display: none;
  }
  .header__menu[aria-expanded='true'] .header__menu-open {
    display: none;
  }
  .header__menu[aria-expanded='true'] .header__menu-close {
    display: block;
  }

  @media (max-width: 1240px) {
    .header__phone-text span {
      display: none;
    }
    .header__nav a {
      padding-inline: 11px;
    }
  }
  @media (max-width: 1120px) {
    :global(:root) {
      --header-h: 72px;
    }
    .header__nav,
    .header__phone {
      display: none;
    }
    .header__actions {
      margin-left: auto;
      gap: 10px;
    }
    .header__menu,
    .header__call-mobile {
      display: grid;
    }
    .header__brand :global(svg) {
      width: 89px;
      height: 46px;
    }
  }
  @media (max-width: 520px) {
    .header__quote {
      display: none;
    }
  }

  .mobile-menu {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    background: var(--white);
    overflow-y: auto;
    padding-block: 8px 40px;
    border-top: 1px solid var(--line-soft);
  }
  .mobile-menu__list {
    list-style: none;
    padding: 0;
  }
  .mobile-menu__list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 0;
    border-bottom: 1px solid var(--line-soft);
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
  }
  .mobile-menu__list a :global(svg) {
    color: var(--muted);
  }
  .mobile-menu__list a[aria-current='page'] {
    color: var(--blue-600);
  }
  .mobile-menu__actions {
    display: grid;
    gap: 12px;
    margin-top: 28px;
  }
  .mobile-menu__email {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 6px;
    font-weight: 600;
    color: var(--ink);
  }
  @media (min-width: 1121px) {
    .mobile-menu {
      display: none !important;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    menu.hidden = !open;
    document.documentElement.style.overflow = open ? 'hidden' : '';
    document.body.classList.toggle('menu-open', open);
  };

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });
  window.matchMedia('(min-width: 1121px)').addEventListener('change', (e) => e.matches && setOpen(false));
</script>
