---
import type { Crumb } from '../layouts/Base.astro';
import Photo from './Photo.astro';
import type { PhotoKey } from '../data/photos';

interface Props {
  crumbs: Crumb[];
  eyebrow?: string;
  title: string;
  lede?: string;
  photo?: PhotoKey;
  photoPosition?: string;
}
const { crumbs, eyebrow, title, lede, photo, photoPosition } = Astro.props;
const hasAside = Astro.slots.has('aside') || !!photo;
---

<section class="phero">
  <div class="container">
    <div class:list={['phero__panel', { 'has-aside': hasAside }]}>
      <div class="phero__main">
        <nav aria-label="Breadcrumb" class="crumbs">
          <ol>
            {
              crumbs.map((c, i) => (
                <li>
                  {i < crumbs.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
                </li>
              ))
            }
          </ol>
        </nav>
        {eyebrow && <span class="eyebrow">{eyebrow}</span>}
        <h1 set:html={title} />
        {lede && <p class="lede">{lede}</p>}
        {Astro.slots.has('actions') && <div class="btn-row phero__actions"><slot name="actions" /></div>}
        <slot />
      </div>
      {
        hasAside && (
          <div class="phero__aside">
            {photo ? (
              <div class="phero__photo">
                <Photo name={photo} eager sizes="(min-width: 1040px) 40vw, 100vw" position={photoPosition} />
                <slot name="aside" />
              </div>
            ) : (
              <slot name="aside" />
            )}
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .phero {
    padding-top: clamp(12px, 2vw, 20px);
  }
  .phero__panel {
    display: grid;
    gap: 36px;
    align-items: center;
    padding: clamp(28px, 4.5vw, 64px);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(1200px 400px at 0% 0%, rgb(255 198 41 / 0.16), transparent 60%),
      linear-gradient(180deg, var(--blue-50), var(--surface));
  }
  @media (min-width: 1040px) {
    .phero__panel.has-aside {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: 56px;
    }
  }
  .phero h1 {
    margin-top: 1.1rem;
    font-size: clamp(2.6rem, 1.9rem + 3vw, 4.4rem);
    max-width: 16ch;
  }
  .phero .lede {
    margin-top: 1.1rem;
  }
  .phero__actions {
    margin-top: 1.8rem;
  }
  .phero__photo {
    position: relative;
  }
  .phero__photo :global(.photo) {
    aspect-ratio: 5 / 4;
    box-shadow: var(--shadow);
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 0;
    list-style: none;
    padding: 0;
    margin-bottom: 22px;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--muted);
  }
  .crumbs li + li::before {
    content: '›';
    margin-inline: 10px;
    color: #9aa6b8;
  }
  .crumbs a {
    color: var(--muted);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .crumbs [aria-current] {
    color: var(--ink);
  }
</style>
