import i_house from 'lucide-static/icons/house.svg?raw';
import i_fan from 'lucide-static/icons/fan.svg?raw';
import i_zap from 'lucide-static/icons/zap.svg?raw';
import i_calendar_check from 'lucide-static/icons/calendar-check.svg?raw';
import i_file_text from 'lucide-static/icons/file-text.svg?raw';
