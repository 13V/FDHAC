{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/air-conditioning-adelaide", "destination": "/home-air-conditioning-adelaide", "statusCode": 301 },
    { "source": "/air-conditioning-adelaide/ducted-reverse-cycle-air-conditioners", "destination": "/ducted-reverse-cycle-air-conditioners", "statusCode": 301 },
    { "source": "/air-conditioning-adelaide/split-system-reverse-cycle-air-conditioners", "destination": "/home-air-conditioning-adelaide#split-systems", "statusCode": 301 },
    { "source": "/air-conditioning-adelaide/heating-your-home", "destination": "/heating-your-home", "statusCode": 301 },
    { "source": "/air-conditioning-adelaide/replacement-units", "destination": "/air-conditioning-adelaide/ducted-air-conditioning-replacement-units", "statusCode": 301 },
    { "source": "/general-information/how-to-reduce-air-conditioning-running-costs", "destination": "/how-to-reduce-air-conditioning-running-costs", "statusCode": 301 },
    { "source": "/general-information/maintenance-tips", "destination": "/air-conditioning-maintenance-tips", "statusCode": 301 },
    { "source": "/general-information/what-is-horsepower", "destination": "/what-is-horsepower", "statusCode": 301 },
    { "source": "/general-information/what-is-an-inverter", "destination": "/faqs", "statusCode": 301 },
    { "source": "/general-information", "destination": "/faqs", "statusCode": 301 },
    { "source": "/cart", "destination": "/", "statusCode": 301 }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": {
            "suf": ".vercel.app"
          }
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
